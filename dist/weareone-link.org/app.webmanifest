{
  "name": "One Link",
  "short_name": "One Link",
  "description": "Open-source pre-release messaging and file transfer. Current website services depend on Cloudflare, GitHub, maintainers, and other infrastructure providers.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#04060b",
  "theme_color": "#04060b",
  "lang": "en",
  "dir": "ltr",
  "categories": ["communication", "productivity", "social"],
  "icons": [
    {
      "src": "/images/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/images/logo-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/logo-256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/images/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Share a file",
      "short_name": "Share",
      "description": "Encrypt up to 25 MB in this browser and create a best-effort one-retrieval link",
      "url": "/share/",
      "icons": [{ "src": "/images/logo-128.png", "sizes": "128x128" }]
    },
    {
      "name": "Get One Link",
      "short_name": "Get it",
      "description": "View available unsigned continuous alpha builds",
      "url": "/download/",
      "icons": [{ "src": "/images/logo-128.png", "sizes": "128x128" }]
    },
    {
      "name": "Website presence",
      "short_name": "Presence",
      "description": "See validated website-presence sessions; this is not relay or node topology",
      "url": "/mesh/",
      "icons": [{ "src": "/images/logo-128.png", "sizes": "128x128" }]
    }
  ]
}
